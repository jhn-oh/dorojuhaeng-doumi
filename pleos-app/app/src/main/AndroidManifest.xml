    <application android:name=".LicenseApp" android:allowBackup="false" android:fullBackupContent="false" android:dataExtractionRules="@xml/data_extraction_rules" android:icon="@android:drawable/ic_menu_agenda" android:label="도로주행 도우미" android:theme="@style/AppTheme" android:supportsRtl="true">
